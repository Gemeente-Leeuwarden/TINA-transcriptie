# RENAME THIS FILE TO .ENV AND CHOOSE YOUR OWN USERNAMES AND PASSWORDS

# Postgres database configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgresww
DB_NAME=TINA_DB
DB_PORT=5432
DB_SSLMODE=false
DB_TIMEZONE=Europe/Amsterdam

# OAuth Encryption Key (generate with: openssl rand -base64 32)
OAUTH_ENCRYPTION_KEY=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=localhost:6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=tinauser
RABBITMQ_PASSWORD=passwd
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672
# Queues used by the transcription worker (gpu/main.py) — must match the
# queue names the Go backend publishes to / consumes from (cmd/platform/main.go)
RABBITMQ_IN_QUEUE=session
RABBITMQ_OUT_QUEUE=transcription
# Heartbeat interval (s) for the worker connection — long, because the worker
# blocks on HTTP calls and can't service heartbeats during a job
RABBITMQ_HEARTBEAT=1800

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audio-recordings-tina
MINIO_USE_SSL=false

# Vosk configuration
VOSK_MODEL_PATH=
VOSK_SAMPLE_RATE=0

# Whisper configuration
WHISPER_CALLBACK_TOKEN=

# Transcription worker (gpu/main.py) — connects to a local transcription
# model server that is NOT part of this project (e.g. speaches, whisper.cpp
# server). TRANSCRIPTION_PROVIDER selects the HTTP client implementation.
# NOTE: when the worker runs in Docker (the compose "worker" service), a model
# server running on the host is NOT reachable via localhost from inside the
# container — use http://host.docker.internal:<port>/... instead. RabbitMQ and
# MinIO are handled automatically by the compose service (service names).
TRANSCRIPTION_PROVIDER=openai_compatible
#TRANSCRIPTION_API_URL=http://localhost:8000/v1/audio/transcriptions
TRANSCRIPTION_API_URL=http://host.docker.internal:8000/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
#TRANSCRIPTION_MODEL=
TRANSCRIPTION_MODEL=Systran/faster-whisper-small
TRANSCRIPTION_LANGUAGE=nl

# LLM prompt worker (gpu/main.py) — OpenAI-compatible chat-completions
# endpoint for applying prompts to transcripts (e.g. Ollama, vLLM, OpenAI)
LLM_PROVIDER=openai_compatible
#LLM_API_URL=http://localhost:1234/v1/chat/completions
LLM_API_URL=http://host.docker.internal:1234/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b

# Application Configuration
APP_ENV=development
APP_PORT=8080

# JSON Web Token (JWT) config
JWT_SECRET=some-long-random-secret-value
JWT_DURATION_IN_HOURS=24

# Feature flags (for login screen, start minimal)
FEATURE_LOCAL_AUTH_ENABLED=true
FEATURE_REGISTRATION_ENABLED=true
FEATURE_AZURE_AUTH_ENABLED=false
FEATURE_WEBSOCKET_ENABLED=true

# Azure Auth configuration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_ENCRYPTION_KEY=
AZURE_REDIRECT_URL=
AZURE_SCOPES=
AZURE_FRONTEND_LOGIN_URL=
AZURE_USER_GROUP=
AZURE_ADMIN_GROUP=